{
  "metadata": {
    "name": "pth-sam31-tracker",
    "namespace": "nuclio",
    "annotations": {
      "name": "SAM3.1 polygon tracker (GPU, experimental)",
      "type": "tracker",
      "version": "1",
      "spec": "[]",
      "supported_shape_types": "polygon"
    }
  },
  "spec": {
    "runtime": "python:3.12",
    "eventTimeout": "120s",
    "minReplicas": 1,
    "maxReplicas": 1,
    "readinessTimeoutSeconds": 300,
    "build": {
      "baseImage": "nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04",
      "image": "cvat.sam31-tracker:source-gpu",
      "directives": {
        "preCopy": [
          {
            "kind": "ENV",
            "value": "DEBIAN_FRONTEND=noninteractive"
          },
          {
            "kind": "ENV",
            "value": "NVIDIA_VISIBLE_DEVICES=all"
          },
          {
            "kind": "ENV",
            "value": "NVIDIA_DRIVER_CAPABILITIES=compute,utility"
          },
          {
            "kind": "RUN",
            "value": "apt-get update && apt-get install -y --no-install-recommends python3.12 python3.12-venv git ca-certificates && rm -rf /var/lib/apt/lists/*"
          },
          {
            "kind": "RUN",
            "value": "python3.12 -m venv /opt/venv"
          },
          {
            "kind": "ENV",
            "value": "PATH=/opt/venv/bin:$PATH"
          },
          {
            "kind": "ENV",
            "value": "NUCLIO_PYTHON_EXE_PATH=/opt/venv/bin/python"
          },
          {
            "kind": "WORKDIR",
            "value": "/opt/nuclio"
          },
          {
            "kind": "RUN",
            "value": "python -m pip install --no-cache-dir \"setuptools==80.9.0\" \"wheel==0.45.1\""
          },
          {
            "kind": "RUN",
            "value": "python -m pip install --no-cache-dir \"torch==2.10.0\" \"torchvision==0.25.0\" --index-url https://download.pytorch.org/whl/cu128"
          },
          {
            "kind": "RUN",
            "value": "python -m pip install --no-cache-dir --no-build-isolation \"numpy==1.26.4\" \"Pillow==11.3.0\" \"opencv-python-headless==4.11.0.86\" \"timm==1.0.24\" \"tqdm==4.67.1\" \"ftfy==6.1.1\" \"regex==2024.11.6\" \"iopath==0.1.10\" \"huggingface-hub==0.36.0\" \"hydra-core==1.3.2\" \"einops==0.8.1\" \"decord==0.6.0\" \"pycocotools==2.0.10\" \"av==14.4.0\" \"scipy==1.15.3\" \"scikit-image==0.25.2\" \"redis==5.2.1\" \"safetensors==0.7.0\" \"git+https://github.com/facebookresearch/sam3.git@0570b3a5be9c4e694f23d85232fb55f4a6f1f7fc\""
          },
          {
            "kind": "RUN",
            "value": "python -c \"import sys, torch; assert sys.version_info[:2] == (3, 12); assert torch.__version__.split('+')[0] == '2.10.0'; assert torch.version.cuda == '12.8'\" && python -m pip freeze > /opt/nuclio/build-requirements.txt"
          }
        ]
      }
    },
    "handler": "main:handler",
    "description": "SAM3.1 fixed-polygon multiplex video tracker; isolated optional extension",
    "triggers": {
      "http": {
        "kind": "http",
        "maxWorkers": 1,
        "workerAvailabilityTimeoutMilliseconds": 10000,
        "attributes": {
          "maxRequestBodySize": 33554432,
          "disablePortPublishing": true
        }
      }
    },
    "resources": {
      "limits": {
        "nvidia.com/gpu": 1
      }
    },
    "platform": {
      "attributes": {
        "restartPolicy": {
          "name": "unless-stopped"
        },
        "mountMode": "volume"
      }
    },
    "env": [
      {
        "name": "SAM31_REDIS_HOST",
        "value": "sam31_redis"
      },
      {
        "name": "SAM31_REDIS_PORT",
        "value": "6379"
      },
      {
        "name": "SAM31_REDIS_PREFIX",
        "value": "cvat:sam31:"
      },
      {
        "name": "SAM31_CHECKPOINT",
        "value": "/models/sam3.1_multiplex.pt"
      },
      {
        "name": "HF_HUB_OFFLINE",
        "value": "1"
      },
      {
        "name": "CUDA_VISIBLE_DEVICES",
        "value": "0"
      }
    ]
  }
}
