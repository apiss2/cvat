# Copy through `components/extensions/cvatctl init`. Do not commit the resulting .env.
# Literal KEY=VALUE only; no shell commands or variable expansion.
CVAT_HOST=localhost
COMPOSE_PROJECT_NAME=cvat
# Comma-separated extension names. Existing source-registered formats stay
# present even when their operation checks are omitted from this selection.
# SAM3.1 is optional: append sam31 after supplying the checkpoint below.
CVAT_EXTENSIONS=itgformat,sam2,ultrasam,model_registry
# Empty values below are derived from COMPOSE_PROJECT_NAME, not the Git branch.
CVAT_NETWORK_NAME=
SAM2_REDIS_VOLUME=
SAM2_REDIS_PASSWORD=GENERATE_ON_INIT
SAM2_REDIS_IMAGE=redis:7.2.11-alpine
SAM2_REDIS_MAXMEMORY=2gb
# SAM2.1 presets: sam2.1_hiera_tiny, sam2.1_hiera_small,
# sam2.1_hiera_base_plus, sam2.1_hiera_large. Empty retains the small model.
SAM2_MODEL=sam2.1_hiera_small
# Optional local fine-tuned checkpoint matching SAM2_MODEL. Empty downloads
# the official preset. Local source files must be outside the checkout.
SAM2_CHECKPOINT_HOST=
# One GPU ID or UUID for UltraSAM's CUDA_VISIBLE_DEVICES; empty uses 0.
# Selects the inference device; Nuclio still exposes all GPUs to the container.
ULTRASAM_GPU_DEVICE=0
# SAM3.1 uses the existing multiplex architecture. Select any compatible
# merged checkpoint by absolute path, normally sam3.1_multiplex.pt.
# Both models embed weights in their images. Normal deployment rebuilds local
# checkpoint images; --no-build reuses the last build. Keep source path settings
# unchanged for --no-build; the source files themselves need not still exist.
SAM31_CHECKPOINT_HOST=
SAM31_REDIS_VOLUME=
SAM31_REDIS_PASSWORD=GENERATE_SAM31_ON_INIT
SAM31_REDIS_MAXMEMORY=2gb
SAM31_STATE_MAX_BYTES=268435456
SAM31_SESSION_TTL_SECONDS=28800
SAM31_GPU_DEVICE=0
NUCLIO_NAMESPACE=nuclio
NUCLIO_DASHBOARD_PORT=8070
# The local model registry belongs to this Compose project and cvatctl operation.
# Empty MR_HOME uses <checkout>/cvat-model-registry, excluded from Git and builds.
# To adopt existing registry storage, set its current home and MR_INSTANCE.
MR_HOME=
MR_INSTANCE=
# Use the exact CVAT browser origin, including HTTPS or a non-default port.
MR_PUBLIC_URL=http://localhost:8080/model-registry/
MR_CVAT_URL=http://cvat_server:8080
MR_CVAT_SESSION_COOKIE=sessionid
# Empty selects the CPU worker. A GPU selection is one numeric ID or GPU UUID.
MR_GPU_DEVICE=
MR_MAX_LOADED=2
MR_WORKER_MEMORY_MIB=4096
MR_WORKER_CPUS=2
MR_STORAGE_GIB=50
# A remote inference host is optional. Set both fields only for that topology.
# Empty URL uses the local manager; its secret directory is derived from MR_HOME.
CVAT_MODEL_REGISTRY_URL=
CVAT_MODEL_GATEWAY_SECRETS_DIR=
# Optional CA bundle path inside /run/secrets for a remote HTTPS registry.
CVAT_MODEL_REGISTRY_CA_FILE=
# Optional, repository-relative or absolute files, separated with semicolons.
# HTTPS / shared-directory / external-database overrides belong here.
# Extension overlays and their UI plugins are selected automatically above.
CVAT_EXTRA_COMPOSE_FILES=
