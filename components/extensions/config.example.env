# components/extensions/cvatctl initで作成し、生成された.envをGitへ登録しません。
# 展開済みのKEY=VALUEを記載します。シェルのコマンドと変数展開は使用できません。
CVAT_HOST=localhost
COMPOSE_PROJECT_NAME=cvat
# 機能名はカンマで区切ります。ソースで登録する形式は選択を外しても残ります。
# SAM3.1を使う場合はsam31を追加し、互換重みをチェックアウト外へ配置します。
# 画面機能はframe_navigation_filter、selective_ai、filtered_exportを追加します。
# タスク共通の背景情報を使う場合はtask_contextを追加します。追加サービスとGPUは不要です。
# 管理対象のUIパスは自動選択するため、CVAT_CLIENT_PLUGINSへ追記しません。
# selective_aiは既存Nuclio APIを有効にします。モデルやGPUは自動配備しません。
# 登録ONNXモデルを使う場合はmodel_registryも選択します。
# model_registryは通常の削除でモデルのファイルも消去し、削除・清掃ログと最小限の記録を残します。
CVAT_EXTENSIONS=itgformat,sam2,ultrasam,model_registry
# 空欄の値はGitブランチではなくCOMPOSE_PROJECT_NAMEから決まります。
CVAT_NETWORK_NAME=
SAM2_REDIS_VOLUME=
SAM2_REDIS_PASSWORD=GENERATE_ON_INIT
SAM2_REDIS_IMAGE=redis:7.2.11-alpine
SAM2_REDIS_MAXMEMORY=2gb
# SAM2.1の構成名はsam2.1_hiera_tiny、sam2.1_hiera_small、
# sam2.1_hiera_base_plus、sam2.1_hiera_largeです。空欄はsmallです。
SAM2_MODEL=sam2.1_hiera_small
# 任意の学習済み重みはSAM2_MODELと同じ構造で、チェックアウト外へ配置します。
# 空欄の場合は選択した公式モデルの重みを取得します。
SAM2_CHECKPOINT_HOST=
# GPU番号またはUUIDを1個指定します。空欄は0です。
# 推論先の選択であり、NuclioからコンテナへのGPU公開範囲は変わりません。
ULTRASAM_GPU_DEVICE=0
# SAM3.1の新規配備には、結合済みsam3.1_multiplex.ptの絶対パスが必要です。
# 両関数のイメージへ同梱し、自動取得は行いません。例: /opt/models/sam3.1_multiplex.pt
SAM31_CHECKPOINT_HOST=
SAM31_REDIS_VOLUME=
SAM31_REDIS_PASSWORD=GENERATE_SAM31_ON_INIT
SAM31_REDIS_MAXMEMORY=2gb
SAM31_STATE_MAX_BYTES=268435456
SAM31_SESSION_TTL_SECONDS=28800
SAM31_GPU_DEVICE=0
NUCLIO_NAMESPACE=nuclio
NUCLIO_DASHBOARD_PORT=8070
# 同じホストのモデル管理はCVATと同じComposeとcvatctlで管理します。
# MR_HOMEの空欄はチェックアウト内のcvat-model-registry/で、Gitとビルドの対象外です。
# 既存保存先を引き継ぐ場合はMR_HOMEと元のMR_INSTANCEを指定します。
MR_HOME=
MR_INSTANCE=
# HTTPSとポート番号も含め、実際のCVAT画面と同じオリジンを指定します。
MR_PUBLIC_URL=http://localhost:8080/model-registry/
MR_CVAT_URL=http://cvat_server:8080
MR_CVAT_SESSION_COOKIE=sessionid
# 空欄はCPUです。GPUは番号またはUUIDを1個指定します。
MR_GPU_DEVICE=
MR_MAX_LOADED=2
MR_WORKER_MEMORY_MIB=4096
MR_WORKER_CPUS=2
MR_STORAGE_GIB=50
# 別の推論ホストを使う場合だけ、接続先と秘密ディレクトリを指定します。
# URLの空欄は同じホストの管理サーバーで、秘密ディレクトリはMR_HOMEから決まります。
CVAT_MODEL_REGISTRY_URL=
CVAT_MODEL_GATEWAY_SECRETS_DIR=
# 別ホストのHTTPS接続に必要な認証局を/run/secrets内のパスで指定できます。
CVAT_MODEL_REGISTRY_CA_FILE=
# 追加Composeの相対または絶対パスをセミコロンで区切ります。
# HTTPS、共有フォルダー、外部DBなどを指定し、自動選択する拡張構成は重複指定しません。
CVAT_EXTRA_COMPOSE_FILES=
