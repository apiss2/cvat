# CVATと追加機能の共通設定
# 作成: ./components/extensions/cvatctl init
# 生成された.envはGitへ登録しません。既存環境では設定を作り直さず必要な項目だけ更新します。
# 値は展開済みのKEY=VALUEで記載します。シェルのコマンドと変数展開は使用できません。
#
# 読む順序: 1の共通設定を確認し、CVAT_EXTENSIONSで選んだ機能の節だけ設定します。
# [確認必須] 利用環境に合うか確認します。合っていれば例の値を使用できます。
# [選択時必須] その機能を使う場合に有効な値が必要です。
# [自動生成] initが秘密情報を生成します。既存環境では元の値を保持します。
# [任意] 通常は記載値を使用します。空欄の意味は各項目の説明に従います。
# 導入手順: docs/extensions/installation.md
# 機能の選び方: docs/extensions/management.md

# 1. 共通設定
# [確認必須] ブラウザーから接続するホスト名またはIP。http(s)://とポートは含めません。
CVAT_HOST=localhost
# [確認必須] Dockerでこの環境を識別する名前。既存環境では変更しません。
COMPOSE_PROJECT_NAME=cvat
# [確認必須] 使用する機能の設定名をカンマで区切ります。空欄なら追加機能を選択しません。
# 初期値はSAM2とUltraSAMのGPUを必要とします。必要な機能だけを残してください。
# データの取り込み: dicom_import, project_annotations, itgformat
# 画像の確認と編集: frame_navigation_filter, physical_measurements, task_context, filtered_export
# モデルによる下書き: sam2, sam31, ultrasam, model_registry, selective_ai
# 各機能の説明と併用条件は上記「機能の選び方」を参照します。
# 選択に応じた画面プラグインは自動設定され、CVAT_CLIENT_PLUGINSへの追記は不要です。
# ITGformatとTask Guideの形式は、ソースに登録済みのため機能の選択を外しても残ります。
CVAT_EXTENSIONS=itgformat,sam2,ultrasam,model_registry
# [任意] Dockerのネットワーク名。空欄は <COMPOSE_PROJECT_NAME>_cvat です。
CVAT_NETWORK_NAME=
# [任意] HTTPS、共有フォルダー、外部DBなどの追加Composeファイルをセミコロンで区切ります。
# 相対パスはリポジトリのルートが基準です。自動選択される機能用ファイルは重複指定しません。
CVAT_EXTRA_COMPOSE_FILES=

# 2. モデルを実行する共通サービス
# Nuclioはモデルの推論処理を実行するサービスです。
# sam2, sam31, ultrasam, model_registry, selective_aiのいずれかを選ぶ場合に使用します。
# [任意] 推論処理をまとめる名前空間。CVATと配備する処理で同じ値を使用します。
NUCLIO_NAMESPACE=nuclio
# [任意] このホストからだけ接続できる管理画面のポートです。
NUCLIO_DASHBOARD_PORT=8070

# 3. SAM2による画像分割と追跡 (CVAT_EXTENSIONSにsam2を選択した場合)
# [任意] sam2.1_hiera_tiny / sam2.1_hiera_small / sam2.1_hiera_base_plus / sam2.1_hiera_large
# 空欄はsam2.1_hiera_smallです。
SAM2_MODEL=sam2.1_hiera_small
# [任意] 独自重みの絶対パス。SAM2_MODELと同じ構造のファイルをチェックアウト外へ置きます。
# 空欄の場合は選択した公式モデルの重みを取得します。
SAM2_CHECKPOINT_HOST=
# 追跡途中の状態はRedisという保存サービスで管理します。
# [任意] 保存ボリューム名。空欄は <COMPOSE_PROJECT_NAME>_sam2_redis_data です。
SAM2_REDIS_VOLUME=
# [自動生成、選択時必須] initが生成するRedis接続用パスワードです。
SAM2_REDIS_PASSWORD=GENERATE_ON_INIT
# [任意] Redisのイメージとメモリー上限です。
SAM2_REDIS_IMAGE=redis:7.2.11-alpine
SAM2_REDIS_MAXMEMORY=2gb

# 4. SAM3.1による画像分割と追跡 (CVAT_EXTENSIONSにsam31を選択した場合)
# [新規配備時必須] 互換性のある結合済みsam3.1_multiplex.ptの絶対パスです。
# チェックアウト外へ置きます。自動取得は行いません。例: /opt/models/sam3.1_multiplex.pt
SAM31_CHECKPOINT_HOST=
# [任意] 保存ボリューム名。空欄は <COMPOSE_PROJECT_NAME>_sam31_redis_data です。
# SAM2の保存ボリュームとは分けます。
SAM31_REDIS_VOLUME=
# [自動生成、選択時必須] initが生成するRedis接続用パスワードです。SAM2と共用しません。
SAM31_REDIS_PASSWORD=GENERATE_SAM31_ON_INIT
# [任意] Redisのメモリー上限、追跡状態1個の上限バイト数、保存期間の秒数です。
SAM31_REDIS_MAXMEMORY=2gb
SAM31_STATE_MAX_BYTES=268435456
SAM31_SESSION_TTL_SECONDS=28800
# [任意] 推論に使うGPUの番号またはUUIDを1個指定します。空欄は0です。
SAM31_GPU_DEVICE=0

# 5. UltraSAMによる超音波画像の分割 (CVAT_EXTENSIONSにultrasamを選択した場合)
# [任意] 推論に使うGPUの番号またはUUIDを1個指定します。空欄は0です。
# SAM3.1とUltraSAMのGPU指定は、Nuclioがコンテナへ公開するGPUの範囲を変更しません。
ULTRASAM_GPU_DEVICE=0

# 6. ONNXモデル管理 (CVAT_EXTENSIONSにmodel_registryを選択した場合)
# 同じDockerホストに管理サービスを置く通常の構成です。
# [選択時必須] 実際のCVAT画面のURLに/model-registry/を付けます。
# http(s)、ホスト、ポートをCVAT画面と一致させます。HTTPS自体の構成は別途必要です。
MR_PUBLIC_URL=http://localhost:8080/model-registry/
# [任意] モデルと設定の保存先。空欄はチェックアウト内のcvat-model-registry/です。
# Gitとビルドの対象外になります。既存データを引き継ぐ場合は元の保存先を指定します。
MR_HOME=
# [任意] 管理サービスの識別名。空欄はCOMPOSE_PROJECT_NAMEです。既存の識別名は維持します。
MR_INSTANCE=
# [任意] 管理サービスからCVATへ接続するURLと、ログイン状態の確認に使うCookie名です。
MR_CVAT_URL=http://cvat_server:8080
MR_CVAT_SESSION_COOKIE=sessionid
# [任意] 推論に使うGPUの番号またはUUIDを1個指定します。空欄はCPUです。
MR_GPU_DEVICE=
# [任意] 同時に読み込むモデルの版数、推論処理ごとのメモリー上限(MiB)、CPU割当数、保存容量上限(GiB)。
MR_MAX_LOADED=2
MR_WORKER_MEMORY_MIB=4096
MR_WORKER_CPUS=2
MR_STORAGE_GIB=50

# 7. ONNXモデル管理を別ホストへ置く場合
# 通常は空欄のままにします。接続手順はdocs/model-registry/deployment.mdを参照します。
# [別ホスト時必須] 接続先URL。空欄は同じホストの http://model-registry:8091 です。
CVAT_MODEL_REGISTRY_URL=
# [別ホスト時必須] 認証情報を置くホスト上のディレクトリです。
# 同じホストの構成ではMR_HOME/config/secretsから自動設定されます。
CVAT_MODEL_GATEWAY_SECRETS_DIR=
# [必要時のみ] HTTPS接続に独自の認証局が必要な場合、/run/secrets内の証明書パスを指定します。
CVAT_MODEL_REGISTRY_CA_FILE=
